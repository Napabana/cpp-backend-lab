{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build thread_pool_demo",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-c",
                "mkdir -p build && g++ -std=c++17 -g -O0 -Wall -Wextra -pedantic -pthread -Iinclude src/main.cpp src/thread_pool.cpp -o build/thread_pool_demo"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}